# ── CLI Mode ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Slack notifications (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# Residential proxy (optional — only needed when running from a VPN or server)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# ── Web UI Mode ────────────────────────────────────────────────────────────────
# Generate a secure random key (minimum 32 characters)
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DATABASE_URL=sqlite:///./database/jobs.db
DEBUG=False
